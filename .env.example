# Puerto serie del Arduino EN EL HOST (Linux o Raspberry Pi).
# El contenedor siempre lo ve como /dev/ttyACM0.
#   ls /dev/ttyACM* /dev/ttyUSB*
SERIAL_DEVICE=COM7

# GID del grupo dueño del puerto (en Raspberry Pi OS / Debian suele ser dialout = 20).
#   ls -l /dev/ttyACM0
DIALOUT_GID=20

# Cada cuántos segundos se vuelve a correr el análisis batch.
BATCH_INTERVAL_S=3600
